# ===================================
# NETLAND - Variables de Producción
# ===================================
# Este archivo es un ejemplo. NO commitear con valores reales.
# Configurar estas variables en Render Dashboard

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/netland?sslmode=require

# Seguridad
# El código lee JWT_SECRET (ver app/core/config.py); el antiguo nombre SECRET_KEY ya no se usa.
JWT_SECRET=genera_una_clave_secreta_muy_larga_y_segura_minimo_32_caracteres
ENVIRONMENT=production
ENABLE_DOCS=false

# Cloudinary (para archivos multimedia)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Frontend URL (Netlify)
FRONTEND_URL=https://netland.netlify.app

# CORS Origins (separados por coma)
CORS_ORIGINS=https://netland.netlify.app,http://localhost:5173

# Configuración de la app
APP_NAME=Netland
DEBUG=false
